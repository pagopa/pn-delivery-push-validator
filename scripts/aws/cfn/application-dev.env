SQS_INTEGRATION_ENABLED=false
#Parameters for throttling of sqs consumers (https://github.com/idealo/spring-cloud-stream-binder-sqs?tab=readme-ov-file#concurrency)
CONSUMER_DELIVERYVALIDATIONEVENTS_MAX_MESSAGES=5
CONSUMER_DELIVERYVALIDATIONEVENTS_CONCURRENCY=1
CONSUMER_VALIDATIONACTIONS_MAX_MESSAGES=5
CONSUMER_VALIDATIONACTIONS_CONCURRENCY=1
CONSUMER_SAFESTORAGEEVENTS_MAX_MESSAGES=5
CONSUMER_SAFESTORAGEEVENTS_CONCURRENCY=1
CONSUMER_ADDRESSMANAGEREVENTS_MAX_MESSAGES=5
CONSUMER_ADDRESSMANAGEREVENTS_CONCURRENCY=1
CONSUMER_F24EVENTS_MAX_MESSAGES=5
CONSUMER_F24EVENTS_CONCURRENCY=1
CONSUMER_NEWNOTIFICATIONS_MAX_MESSAGES=5
CONSUMER_NEWNOTIFICATIONS_CONCURRENCY=1
CONSUMER_FROMEXTERNALCHANNEL_MAX_MESSAGES=5
CONSUMER_FROMEXTERNALCHANNEL_CONCURRENCY=1
CONSUMER_SCHEDULEDACTIONS_MAX_MESSAGES=5
CONSUMER_SCHEDULEDACTIONS_CONCURRENCY=1
CONSUMER_NATIONALREGISTRIESEVENTS_MAX_MESSAGES=5
CONSUMER_NATIONALREGISTRIESEVENTS_CONCURRENCY=1