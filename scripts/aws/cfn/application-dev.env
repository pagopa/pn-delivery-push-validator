SQS_INTEGRATION_ENABLED=true
#Enables retry of the notification validation in case of SafeStorage 404 error
PN_DELIVERYPUSHVALIDATOR_SAFESTORAGEFILENOTFOUNDRETRY=false
#Attachment retention after validation. Note: This number is defined on safeStorage, so a change to these properties does not imply a change to effective file retention'
PN_DELIVERYPUSHVALIDATOR_TIMEPARAMSMAP_LEGAL_ATTACHMENTRETENTIONTIMEAFTERVALIDATION=120d
#Defines how long before the attachment retention expires need to start check attachment retention'
PN_DELIVERYPUSHVALIDATOR_TIMEPARAMSMAP_LEGAL_CHECKATTACHMENTTIMEBEFOREEXPIRATION=10d
PN_DELIVERYPUSHVALIDATOR_TIMEPARAMSMAP_INFORMAL_ATTACHMENTRETENTIONTIMEAFTERVALIDATION=120d
PN_DELIVERYPUSHVALIDATOR_TIMEPARAMSMAP_INFORMAL_CHECKATTACHMENTTIMEBEFOREEXPIRATION=10d
#Time interval between validations retry
PN_DELIVERYPUSHVALIDATOR_VALIDATIONRETRYINTERVALS=10s, 1m, 1m, 5m, 1h, -1s
#Enable additional languages feature
PN_DELIVERYPUSHVALIDATOR_ADDITIONALLANGSENABLED=true
#Notification cost for technical refusal. Comma separated list made up by: RefusalCostMode(UNIFORM or RECIPIENT_BASED);RefusalCost(in eurocents)
PN_DELIVERYPUSHVALIDATOR_TECHNICALREFUSALCOSTMODE=RECIPIENT_BASED;50
#Address manager base url
PN_DELIVERYPUSHVALIDATOR_ADDRESSMANAGERBASEURL=http://alb.confidential.pn.internal:8080
#Enable check cf
PN_DELIVERYPUSHVALIDATOR_CHECKCFENABLED=false
#Enable pdf content check
PN_DELIVERYPUSHVALIDATOR_CHECKPDFVALIDENABLED=true
#Max pdf allowed size, -1 for disable check
PN_DELIVERYPUSHVALIDATOR_CHECKPDFSIZE=200MB
#PagoPa notification base cost
PN_DELIVERYPUSHVALIDATOR_PAGOPANOTIFICATIONBASECOST=100
#Valore di default dell'abilitazione ad inviare notifche con piú di 2 fogli oltre l'AAR (20 grammi). Il valore di abilitazione puó essere sovrascritto dal Parameter Store MapPaSendMoreThan20Grams nel parametro canSendMoreThan20Grams.
PN_DELIVERYPUSHVALIDATOR_SENDMORETHAN20GRAMSDEFAULTVALUE=true
